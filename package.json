{
  "name": "max-green-chat",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "type-check": "tsc --noEmit",
    "lint": "eslint src *.ts --ext .ts,.tsx --max-warnings 0",
    "lint:fix": "npm run lint -- --fix",
    "lint:all": "npm run type-check && npm run lint",
    "build": "npm run type-check && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "format": "prettier --write src *.ts *.json *.cjs index.html README.md",
    "format:check": "prettier --check src *.ts *.json *.cjs index.html README.md"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "react-helmet-async": "^2.0.5",
    "@reduxjs/toolkit": "^2.6.0",
    "react-redux": "^9.2.0",
    "axios": "^1.8.0",
    "antd": "^5.24.0",
    "@ant-design/icons": "^5.6.0",
    "@fontsource/manrope": "^5.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "prettier": "^3.9.9",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-react-swc": "^3.8.0",
    "less": "^4.2.0",
    "eslint": "^8.57.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-boundaries": "^5.0.0",
    "eslint-plugin-simple-import-sort": "^12.1.0",
    "@typescript-eslint/parser": "^8.26.0",
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "eslint-import-resolver-typescript": "^3.8.0",
    "vite-plugin-svgr": "^4.3.0"
  },
  "overrides": {
    "handlebars": "^4.7.9"
  }
}
